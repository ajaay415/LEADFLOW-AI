# Local Ollama configuration
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=90

# Comma-separated frontend origins allowed by FastAPI
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Outlook / Microsoft 365 SMTP configuration (required only for sending email)
# Microsoft 365 work/school: smtp.office365.com | port 587 | STARTTLS
# Personal Outlook.com: smtp-mail.outlook.com | port 587 | STARTTLS
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.office365.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
